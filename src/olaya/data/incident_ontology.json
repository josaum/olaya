"{\n  \"name\": \"EnterpriseIncidentOntology\",\n  \"concepts\": [\n    {\n      \"curie\": \"INCIDENT:ROOT\",\n      \"label\": \"Operational Incident\",\n      \"description\": \"Any anomalous operational event.\",\n      \"synonyms\": [],\n      \"parents\": [],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:INFRA\",\n      \"label\": \"Infrastructure Incident\",\n      \"description\": \"Hardware, compute, hypervisor, or OS issues.\",\n      \"synonyms\": [],\n      \"parents\": [\n        \"INCIDENT:ROOT\"\n      ],\n      \"disjoint_with\": [\n        \"INCIDENT:BILLING\"\n      ],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:DATA\",\n      \"label\": \"Data & Storage Incident\",\n      \"description\": \"Database, cache, message broker, or pipeline issues.\",\n      \"synonyms\": [],\n      \"parents\": [\n        \"INCIDENT:ROOT\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:SECURITY\",\n      \"label\": \"Security & Access Incident\",\n      \"description\": \"Unauthorized access, breach, credential leak, or policy violation.\",\n      \"synonyms\": [],\n      \"parents\": [\n        \"INCIDENT:ROOT\"\n      ],\n      \"disjoint_with\": [\n        \"INCIDENT:BILLING\"\n      ],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:BILLING\",\n      \"label\": \"Billing & Commercial Incident\",\n      \"description\": \"Invoicing, payment processing, subscription, or checkout errors.\",\n      \"synonyms\": [],\n      \"parents\": [\n        \"INCIDENT:ROOT\"\n      ],\n      \"disjoint_with\": [\n        \"INCIDENT:INFRA\",\n        \"INCIDENT:SECURITY\"\n      ],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:APPLICATION\",\n      \"label\": \"Application Error\",\n      \"description\": \"Client UI glitches, 5xx server exceptions, or logic bugs.\",\n      \"synonyms\": [],\n      \"parents\": [\n        \"INCIDENT:ROOT\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:DB_OUTAGE\",\n      \"label\": \"Database Outage\",\n      \"description\": \"Complete loss of primary DB or replica cluster connectivity.\",\n      \"synonyms\": [\n        \"db down\",\n        \"postgres unreachable\",\n        \"mysql connection refused\"\n      ],\n      \"parents\": [\n        \"INCIDENT:DATA\"\n      ],\n      \"disjoint_with\": [\n        \"INCIDENT:INVOICE_MISCALC\"\n      ],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:DB_DEADLOCK\",\n      \"label\": \"Database Deadlock\",\n      \"description\": \"Concurrent transactions blocked waiting for conflicting locks.\",\n      \"synonyms\": [\n        \"lock wait timeout\",\n        \"deadlock detected\"\n      ],\n      \"parents\": [\n        \"INCIDENT:DATA\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:DATA_PIPELINE\",\n      \"label\": \"Data Pipeline Stall\",\n      \"description\": \"Kafka lag, Celery/Airflow failure, or consumer crash.\",\n      \"synonyms\": [\n        \"kafka lag\",\n        \"dag failed\"\n      ],\n      \"parents\": [\n        \"INCIDENT:DATA\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:AUTH_BREACH\",\n      \"label\": \"Authentication Breach\",\n      \"description\": \"Compromised credentials, unauthorized token issuance, or brute-force attack.\",\n      \"synonyms\": [\n        \"api key leaked\",\n        \"unauthorized login\"\n      ],\n      \"parents\": [\n        \"INCIDENT:SECURITY\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:DDOS\",\n      \"label\": \"DDoS Attack\",\n      \"description\": \"High-volume distributed traffic overwhelming ingress points.\",\n      \"synonyms\": [\n        \"dos attack\",\n        \"syn flood\"\n      ],\n      \"parents\": [\n        \"INCIDENT:SECURITY\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:PAYMENT_GATEWAY\",\n      \"label\": \"Payment Gateway Failure\",\n      \"description\": \"Stripe/Adyen/banking webhook failures or payment processing errors.\",\n      \"synonyms\": [\n        \"stripe 500\",\n        \"payment decline storm\"\n      ],\n      \"parents\": [\n        \"INCIDENT:BILLING\"\n      ],\n      \"disjoint_with\": [],\n      \"metadata\": {}\n    },\n    {\n      \"curie\": \"INCIDENT:INVOICE_MISCALC\",\n      \"label\": \"Invoice Calculation Error\",\n      \"description\": \"Incorrect tax, discount, or pricing tier billing error.\",\n      \"synonyms\": [\n        \"overcharged\",\n        \"wrong tax\"\n      ],\n      \"parents\": [\n        \"INCIDENT:BILLING\"\n      ],\n      \"disjoint_with\": [\n        \"INCIDENT:DB_OUTAGE\"\n      ],\n      \"metadata\": {}\n    }\n  ]\n}"