{
  "@context": {
    "studio": "urn:mycelia:studio:",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "cent": "urn:central:strategy:"
  },
  "@graph": [
    {
      "@id": "urn:mycelia:studio:",
      "@type": "owl:Ontology",
      "rdfs:label": "Mycelia Studio Presentation & Report TBox Ontology",
      "rdfs:comment": "Formal OWL 2 TBox defining all structural components, layouts, cards, blocks, brand tokens, and semantic attributes of Mycelia Studio decks and reports."
    },
    {
      "@id": "studio:PresentationDocument",
      "@type": "owl:Class",
      "rdfs:label": "Presentation Document Root",
      "rdfs:comment": "Superclass of all presentation artifacts generated by Mycelia Studio."
    },
    {
      "@id": "studio:Deck",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:PresentationDocument"
      },
      "rdfs:label": "Presentation Slide Deck",
      "rdfs:comment": "Deterministic Typst-rendered presentation slide deck with convex tessellation."
    },
    {
      "@id": "studio:Report",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:PresentationDocument"
      },
      "rdfs:label": "Dense Narrative Report",
      "rdfs:comment": "Dense executive narrative report rendered via Typst or LaTeX."
    },
    {
      "@id": "studio:DeckBriefing",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:PresentationDocument"
      },
      "rdfs:label": "Executive Presentation Strategic Briefing",
      "rdfs:comment": "Structured pre-render briefing capturing governing thought, audience context, and narrative spine."
    },
    {
      "@id": "studio:DocumentNode",
      "@type": "owl:Class",
      "rdfs:label": "Document Structural Node",
      "rdfs:comment": "Base structural element contained within a presentation document."
    },
    {
      "@id": "studio:Slide",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:DocumentNode"
      },
      "rdfs:label": "Deck Slide Page",
      "rdfs:comment": "Single presentation slide page carrying title, layout, blocks, and evidence."
    },
    {
      "@id": "studio:ReportSection",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:DocumentNode"
      },
      "rdfs:label": "Report Section",
      "rdfs:comment": "Hierarchical section within a dense narrative report."
    },
    {
      "@id": "studio:SlideBrief",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:DocumentNode"
      },
      "rdfs:label": "Slide Strategic Brief",
      "rdfs:comment": "Strategic brief for an individual slide specifying takeaway, rationale, and visual anchor."
    },
    {
      "@id": "studio:SlideLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:DocumentNode"
      },
      "rdfs:label": "Slide Layout Geometry",
      "rdfs:comment": "Layout geometry strategy determining slide spatial arrangement."
    },
    {
      "@id": "studio:DefaultLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Default Content Slide Layout",
      "rdfs:comment": "Standard layout rendering action title and sequential content blocks."
    },
    {
      "@id": "studio:SectionDividerLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Full-Bleed Section Transition Divider",
      "rdfs:comment": "Full-bleed section transition page carrying category kicker and governing thought."
    },
    {
      "@id": "studio:BigStatLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Hero Big Statistic Display",
      "rdfs:comment": "Hero single-statistic display with anchor metric, label, and contextual qualification."
    },
    {
      "@id": "studio:QuoteLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Executive Pull-Quote Display",
      "rdfs:comment": "Prominent pull-quote display with citation attribution."
    },
    {
      "@id": "studio:SplitLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Asymmetric Two-Column Split Layout",
      "rdfs:comment": "Asymmetric split layout with high-contrast colored left title and right body prose."
    },
    {
      "@id": "studio:BentoGridLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Templated Bento Grid Mosaic",
      "rdfs:comment": "Fixed templated grid mosaic composed of structured Bento cards."
    },
    {
      "@id": "studio:TessellatedLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Power-Diagram Convex Tessellated Mosaic",
      "rdfs:comment": "Dynamically partitioned convex cells weighted by content volume using power-diagram Voronoi solving. Mathematically guaranteed zero overflow."
    },
    {
      "@id": "studio:ProcessFlowLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Sequential Process & Chevron Flow",
      "rdfs:comment": "Horizontal chevron or numbered process flow detailing phased execution."
    },
    {
      "@id": "studio:StatusTableLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Milestone & Hurdle Status Matrix",
      "rdfs:comment": "Audit and milestone verification matrix with visual status indicators."
    },
    {
      "@id": "studio:ClosingLayout",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "Closing Call-to-Action & Contact Page",
      "rdfs:comment": "Closing recommendation callout with contact details."
    },
    {
      "@id": "studio:VisualComponent",
      "@type": "owl:Class",
      "rdfs:label": "Visual Sub-Element",
      "rdfs:comment": "Autonomous visual component contained within slides or layouts."
    },
    {
      "@id": "studio:BentoCard",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Weighted Bento Site Cell",
      "rdfs:comment": "Bento cell site with title, stat, subtitle, description, area weight, and semantic role."
    },
    {
      "@id": "studio:ProcessStep",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Process Milestone Step",
      "rdfs:comment": "Single execution step in a process flow sequence."
    },
    {
      "@id": "studio:StatusRow",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Status Matrix Evaluation Row",
      "rdfs:comment": "Evaluation row in a status table."
    },
    {
      "@id": "studio:StatusCell",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Status Matrix Indicator Cell",
      "rdfs:comment": "Indicator cell carrying status verdict."
    },
    {
      "@id": "studio:CheckStatusCell",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:StatusCell"
      },
      "owl:disjointWith": {
        "@id": "studio:CrossStatusCell"
      },
      "rdfs:label": "Checkmark Status Cell (Passed / Satisfied)",
      "rdfs:comment": "Green checkmark indicator asserting hurdle criterion or milestone is met."
    },
    {
      "@id": "studio:CrossStatusCell",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:StatusCell"
      },
      "owl:disjointWith": {
        "@id": "studio:CheckStatusCell"
      },
      "rdfs:label": "Cross Status Cell (Deficient / Failed)",
      "rdfs:comment": "Red cross indicator asserting hurdle criterion or milestone failed."
    },
    {
      "@id": "studio:TextStatusCell",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:StatusCell"
      },
      "rdfs:label": "Text Status Cell",
      "rdfs:comment": "Textual status description in a status matrix."
    },
    {
      "@id": "studio:Chart",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Visual Quantitative Chart",
      "rdfs:comment": "Structured chart visualization (bar, horizontal-bar, line, sparkline)."
    },
    {
      "@id": "studio:ChartPoint",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Chart Data Point",
      "rdfs:comment": "Discrete quantitative datum with category label and numeric value."
    },
    {
      "@id": "studio:Kpi",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Key Performance Indicator Tile",
      "rdfs:comment": "Paired metric value and label."
    },
    {
      "@id": "studio:Column",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:label": "Table Column Header",
      "rdfs:comment": "Table column specification including header text, alignment, and width."
    },
    {
      "@id": "studio:ContentBlock",
      "@type": "owl:Class",
      "rdfs:label": "Content Body Block",
      "rdfs:comment": "Sequential content block within slides, sections, or reports."
    },
    {
      "@id": "studio:HeadingBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Section Heading Block"
    },
    {
      "@id": "studio:ParagraphBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Markdown-Lite Paragraph Block"
    },
    {
      "@id": "studio:BulletListBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Bullet List Block"
    },
    {
      "@id": "studio:EnumerateBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Numbered Enumerate Block"
    },
    {
      "@id": "studio:KpiGridBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "KPI Tiles Grid Block"
    },
    {
      "@id": "studio:TableBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Tabular Data Block"
    },
    {
      "@id": "studio:CalloutBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Callout Box Block"
    },
    {
      "@id": "studio:ColumnsBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Multi-Column Layout Block"
    },
    {
      "@id": "studio:ImageBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Embedded Image Block"
    },
    {
      "@id": "studio:ChartBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Standalone Chart Block"
    },
    {
      "@id": "studio:MediaBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Dynamic Media Injection Block"
    },
    {
      "@id": "studio:RawBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Verbatim Code / Markup Passthrough Block"
    },
    {
      "@id": "studio:PageBreakBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Page Break Block"
    },
    {
      "@id": "studio:VSpaceBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Vertical Space Block"
    },
    {
      "@id": "studio:DataQueryBlock",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "Render-Time Data Bound Query Block"
    },
    {
      "@id": "studio:BrandTheme",
      "@type": "owl:Class",
      "rdfs:label": "Design System Brand Theme",
      "rdfs:comment": "Tenant-level design system locking colors and typography against AI slop."
    },
    {
      "@id": "studio:Palette",
      "@type": "owl:Class",
      "rdfs:label": "Hex Color Palette",
      "rdfs:comment": "Locked 9-role brand color palette."
    },
    {
      "@id": "studio:FontStacks",
      "@type": "owl:Class",
      "rdfs:label": "Font Fallback Stacks",
      "rdfs:comment": "Ordered typography font families for sans, serif, and mono roles."
    },
    {
      "@id": "studio:AudienceContext",
      "@type": "owl:Class",
      "rdfs:label": "Audience Decision Context",
      "rdfs:comment": "Executive audience analysis: decision makers, rights (RACI), and room sensitivities."
    },
    {
      "@id": "studio:NarrativeArc",
      "@type": "owl:Class",
      "rdfs:label": "Minto SCR Narrative Arc",
      "rdfs:comment": "Situation-Complication-Resolution structural narrative progression."
    },
    {
      "@id": "studio:SourceCitation",
      "@type": "owl:Class",
      "rdfs:label": "Evidence Source Citation",
      "rdfs:comment": "Audited empirical source grounding slide conclusions."
    },
    {
      "@id": "studio:Footnote",
      "@type": "owl:Class",
      "rdfs:label": "Evidence Footnote",
      "rdfs:comment": "Numbered qualification footnote."
    },
    {
      "@id": "studio:hasSlide",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:Deck"
      },
      "rdfs:range": {
        "@id": "studio:Slide"
      },
      "rdfs:label": "has slide"
    },
    {
      "@id": "studio:hasSlideBrief",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:DeckBriefing"
      },
      "rdfs:range": {
        "@id": "studio:SlideBrief"
      },
      "rdfs:label": "has slide brief"
    },
    {
      "@id": "studio:hasSection",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:Report"
      },
      "rdfs:range": {
        "@id": "studio:ReportSection"
      },
      "rdfs:label": "has report section"
    },
    {
      "@id": "studio:hasLayout",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:Slide"
      },
      "rdfs:range": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:label": "has layout"
    },
    {
      "@id": "studio:hasCard",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:SlideLayout"
      },
      "rdfs:range": {
        "@id": "studio:BentoCard"
      },
      "rdfs:label": "has bento card"
    },
    {
      "@id": "studio:hasBlock",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:DocumentNode"
      },
      "rdfs:range": {
        "@id": "studio:ContentBlock"
      },
      "rdfs:label": "has content block"
    },
    {
      "@id": "studio:hasStep",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:ProcessFlowLayout"
      },
      "rdfs:range": {
        "@id": "studio:ProcessStep"
      },
      "rdfs:label": "has process step"
    },
    {
      "@id": "studio:hasRow",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:StatusTableLayout"
      },
      "rdfs:range": {
        "@id": "studio:StatusRow"
      },
      "rdfs:label": "has status row"
    },
    {
      "@id": "studio:hasCell",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:StatusRow"
      },
      "rdfs:range": {
        "@id": "studio:StatusCell"
      },
      "rdfs:label": "has status cell"
    },
    {
      "@id": "studio:hasChart",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:VisualComponent"
      },
      "rdfs:range": {
        "@id": "studio:Chart"
      },
      "rdfs:label": "has chart"
    },
    {
      "@id": "studio:hasPoint",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:Chart"
      },
      "rdfs:range": {
        "@id": "studio:ChartPoint"
      },
      "rdfs:label": "has data point"
    },
    {
      "@id": "studio:hasKpi",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:KpiGridBlock"
      },
      "rdfs:range": {
        "@id": "studio:Kpi"
      },
      "rdfs:label": "has KPI tile"
    },
    {
      "@id": "studio:hasColumn",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:TableBlock"
      },
      "rdfs:range": {
        "@id": "studio:Column"
      },
      "rdfs:label": "has table column"
    },
    {
      "@id": "studio:hasBrandTheme",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:PresentationDocument"
      },
      "rdfs:range": {
        "@id": "studio:BrandTheme"
      },
      "rdfs:label": "has brand theme"
    },
    {
      "@id": "studio:hasPalette",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:BrandTheme"
      },
      "rdfs:range": {
        "@id": "studio:Palette"
      },
      "rdfs:label": "has color palette"
    },
    {
      "@id": "studio:hasFonts",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:BrandTheme"
      },
      "rdfs:range": {
        "@id": "studio:FontStacks"
      },
      "rdfs:label": "has font stacks"
    },
    {
      "@id": "studio:hasAudience",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:DeckBriefing"
      },
      "rdfs:range": {
        "@id": "studio:AudienceContext"
      },
      "rdfs:label": "has audience context"
    },
    {
      "@id": "studio:hasNarrativeArc",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:DeckBriefing"
      },
      "rdfs:range": {
        "@id": "studio:NarrativeArc"
      },
      "rdfs:label": "has narrative arc"
    },
    {
      "@id": "studio:groundedConcept",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "studio:DocumentNode"
      },
      "rdfs:range": {
        "@id": "owl:Thing"
      },
      "rdfs:label": "grounded to strategic ontology concept",
      "rdfs:comment": "Explicit link grounding slide, card, or block to an enterprise strategy concept (e.g. cent:ConsumablePetWellness)."
    },
    {
      "@id": "studio:title",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "title"
    },
    {
      "@id": "studio:subtitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "subtitle"
    },
    {
      "@id": "studio:product",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "product line / tenant"
    },
    {
      "@id": "studio:period",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "reporting period"
    },
    {
      "@id": "studio:date",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "calendar date"
    },
    {
      "@id": "studio:author",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "document author"
    },
    {
      "@id": "studio:publisher",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "publishing entity"
    },
    {
      "@id": "studio:headerLeft",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "header left text"
    },
    {
      "@id": "studio:headerRight",
      "@type": "owl:DatatypeProperty",
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "header right text"
    },
    {
      "@id": "studio:goal",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "studio:Deck"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "deck governing thought / goal"
    },
    {
      "@id": "studio:governingGoal",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": {
        "@id": "studio:DeckBriefing"
